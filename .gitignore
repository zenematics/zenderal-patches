# Editor / OS
.vscode/
.venv/
.DS_Store
Thumbs.db

# Machine-specific tool/modlist paths — never commit. Copy from tools.example.json.
/.claude/config/tools.json

# The installed Zenderal MO2 instance — HUNDREDS of GB, third-party content.
# Includes the Enderal game copy, mods, tools, and downloads.
# Install anywhere and point .claude/config/tools.json at it; if you install under the
# repo, keep it in this gitignored folder. See the modlist-install skill.
/modlist/
/downloads/

# Extracted Papyrus source trees. Enderal's ScriptsEnderal.zip and Skyrim's Scripts.zip
# have to be unpacked somewhere before you can compile against them; they are third-party
# game content and are never committed. Unpack them outside the repo, or here.
/papyrus-source/

# CommonLibSSE-NG checkout (alandtse/CommonLibVR, ng branch) shared by every native SKSE DLL
# patch in src/ — third-party, cloned per machine, never committed.
/lib/

# Binary Bethesda plugins — never commit. Edit the YAML, deserialize to build these.
# CAUTION: Spriggit names its YAML cell/worldspace record *folders*
# "<Name> - <FormID>_<Master>.esp" (or .esm/.esl), so a bare "*.esp" glob would ignore
# the committed source tree. So: ignore plugin FILES with these extensions at any depth,
# then re-include DIRECTORIES ending in them (the trailing "/" restricts to folders) so
# their YAML contents stay tracked.
*.esp
*.esm
*.esl
!*.esp/
!*.esm/
!*.esl/

# Build output only — build/staging/<release>/ is NOT ignored: it holds the committed FOMOD source
# under build/staging/<release>/fomod/, so the tree in git looks like the real installed mod folder.
# The derived parts inside it (.esp, compiled .pex) are still caught by the *.esp/*.esm/*.esl/*.pex
# rules below. Only the packed archives are ignored here.
/build/dist/

# ...except loose files copied in by the manifest's "files" key (e.g. a SPID _DISTR.ini), which are
# DERIVED — the source of truth is src/<PatchName>/. Unlike .esp/.pex they have no extension rule.
# Add one line per extension a "files" block copies, or the staged copy gets committed alongside
# the src/ original and the two drift.
/build/staging/**/*.ini
/build/staging/**/*.txt
/build/staging/**/*.svg
/build/staging/**/*.psc
/build/staging/**/*.json
/build/staging/**/*.dll

# Bethesda archives — large binaries, never commit. Extract scripts with bsa-extract.
*.bsa
*.ba2

# Packaged release archives (Nexus uploads etc.) — large binaries, rebuild from source.
*.7z

# Packaging build artifacts — derivable, do NOT commit.
# Source of truth = Spriggit YAML + src/<PatchName>/Scripts/source/*.psc.
/dist/

# Compiled Papyrus is ignored BY DEFAULT...
*.pex

# ...but a patch that ships scripts must opt its compiled folder back in, because CI cannot run
# the Papyrus compiler (it needs the licensed base-game + Enderal script source) and therefore
# packages the committed .pex as-is. Recompile and re-commit whenever a .psc changes —
# build/build.ps1 fails if a .pex is MISSING but cannot tell that one is STALE.
# See "CI build & release" in README.md.
#
# Add one pair of lines per script-shipping patch (the /mod-new-plugin skill does this for you):
# !src/<PatchName>/Scripts/compiled/
# !src/<PatchName>/Scripts/compiled/*.pex
!src/SkipPrologue/Scripts/compiled/
!src/SkipPrologue/Scripts/compiled/*.pex
!src/KataFixes/Scripts/compiled/
!src/KataFixes/Scripts/compiled/*.pex
!src/EGO21Compat/Scripts/compiled/
!src/EGO21Compat/Scripts/compiled/*.pex
!src/ControllerTweaks/Scripts/compiled/
!src/ControllerTweaks/Scripts/compiled/*.pex
!src/BrawlFixes/Scripts/compiled/
!src/BrawlFixes/Scripts/compiled/*.pex
!src/LearningBooks/Scripts/compiled/
!src/LearningBooks/Scripts/compiled/*.pex
!src/ZenTraitsFixes/Scripts/compiled/
!src/ZenTraitsFixes/Scripts/compiled/*.pex
!src/SettingsApplier/Scripts/compiled/
!src/SettingsApplier/Scripts/compiled/*.pex
!src/FeverDeathLatchFix/Scripts/compiled/
!src/FeverDeathLatchFix/Scripts/compiled/*.pex
!src/FlintlockOverhaul/Scripts/compiled/
!src/FlintlockOverhaul/Scripts/compiled/*.pex
!src/FlameShot/Scripts/compiled/
!src/FlameShot/Scripts/compiled/*.pex

# Reference decompiles — Enderal's ESM and third-party plugins serialized ONLY for FormKey
# lookups. Large, regenerated locally from each machine's own copy, never committed.
/reference/

# FormKey cache built by arch-docs/EGO/tools/ego_report.py from /reference/ — ~13 MB, derived,
# rebuild with `python arch-docs/EGO/tools/ego_report.py index`.
/arch-docs/EGO/tools/.ego_index.json

# MagicExtract (arch-docs/magic/): build output, and the fat per-chain provenance dump.
# The dataset JSON/CSV/MD in arch-docs/magic/ IS committed — only these derived pieces are not.
/arch-docs/magic/tools/MagicExtract/bin/
/arch-docs/magic/tools/MagicExtract/obj/
/arch-docs/magic/data/.provenance.json

/zenderal/

# Python bytecode from the src/*/tools generators.
__pycache__/
*.pyc

# NetScriptFramework plugin build output (source is committed; ship the built DLL via the manifest)
/src/*/NetScriptPlugin/bin/
/src/*/NetScriptPlugin/obj/

# LibreOffice/OpenOffice lock files
.~lock.*#
!src/Prophecy/Scripts/compiled/
!src/Prophecy/Scripts/compiled/*.pex

# KataAffinities21: extracted third-party BSA contents + generator temp dirs
/src/KataAffinities21/build/
!src/KataAffinities21/Scripts/compiled/
!src/KataAffinities21/Scripts/compiled/*.pex

# SKSE plugin CMake/vcpkg build trees (the shipped DLL lives in compiled/)
/src/*/SKSEPlugin/build/
/src/*/SKSEPlugin/build.log
/src/*/build-ae.log
!src/PerkOverhaul/Scripts/compiled/
!src/PerkOverhaul/Scripts/compiled/*.pex
!src/TraitsRework/Scripts/compiled/
!src/TraitsRework/Scripts/compiled/*.pex
!src/Goblins/Scripts/compiled/
!src/Goblins/Scripts/compiled/*.pex

# Curator artwork sources (large PNGs); src/TraitsRework/tools/02-build-icons.py reads outputs/trait-icons/
/outputs/
!src/ProphecyV2/Scripts/compiled/
!src/ProphecyV2/Scripts/compiled/*.pex
!src/TestingCheats/Scripts/compiled/
!src/TestingCheats/Scripts/compiled/*.pex
!src/ArkGateSiegeFix/Scripts/compiled/
!src/ArkGateSiegeFix/Scripts/compiled/*.pex

# Build output (build.ps1 staging) - commit source, not build artifacts
/build/staging/
# SureAI voice lines extracted for the trailer (copyrighted; never redistribute)
/trailer-audio/
