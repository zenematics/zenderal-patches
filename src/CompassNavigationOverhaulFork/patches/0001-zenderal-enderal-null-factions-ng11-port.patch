new file mode 100644
index 0000000000000000000000000000000000000000..aa236b2071c228e90b6874e70c13f59e399d1af1
--- /dev/null
+++ b/zen/CMakeLists.txt
@@ -0,0 +1,29 @@
+# Zenderal rebuild of Compass Navigation Overhaul (alexsylex, MIT) at 4055b00 (DLL code = f39e969, what the Enderal patch was
+# built from) with null-safe faction lookups, against CommonLibSSE-NG 11.0.0 for SE 1.5.97 + AE incl. 1.7.104.
+# Mirrors ../CMakeLists.txt; CommonLib source, runtime flags and Address Library declaration differ; no auto-deploy; LTCG off.
+cmake_minimum_required(VERSION 3.21)
+project(CompassNavigationOverhaul VERSION 2.2.0 LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 23)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+
+set(ENABLE_SKYRIM_SE ON CACHE BOOL "" FORCE)
+set(ENABLE_SKYRIM_AE ON CACHE BOOL "" FORCE)
+set(ENABLE_SKYRIM_VR OFF CACHE BOOL "" FORCE)
+set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(SKSE_SUPPORT_PATCH_SAFETY OFF CACHE BOOL "" FORCE)
+set(SKSE_SUPPORT_XBYAK ON CACHE BOOL "" FORCE)  # CNO utils/Trampoline.h needs it
+add_subdirectory("${CMAKE_CURRENT_SOURCE_DIR}/../../../CommonLibNG" CommonLibNG EXCLUDE_FROM_ALL)
+include("${CMAKE_CURRENT_SOURCE_DIR}/../../../CommonLibNG/cmake/CommonLibSSE.cmake")
+
+file(GLOB_RECURSE headers "../include/*.h")
+file(GLOB_RECURSE sources "../source/*.cpp")
+
+add_commonlibsse_plugin(${PROJECT_NAME} USE_ADDRESS_LIBRARY SOURCES ${headers} ${sources})
+target_include_directories(${PROJECT_NAME} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/../include")
+target_compile_definitions(${PROJECT_NAME} PRIVATE NOMINMAX)
+find_package(directxtk CONFIG REQUIRED)
+find_package(xbyak CONFIG REQUIRED)
+target_link_libraries(${PROJECT_NAME} PRIVATE CommonLibSSE::CommonLibSSE Microsoft::DirectXTK xbyak::xbyak)
+target_precompile_headers(${PROJECT_NAME} PRIVATE ../include/PCH.h)
