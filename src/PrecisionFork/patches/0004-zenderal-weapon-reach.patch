+
+	bool IsWeaponEligible(RE::Actor* a_actor, bool a_bLeft, bool a_bIsBashing)
+	{
+		if (!g_weaponEnable || !a_actor || a_bIsBashing) {
+			return false;
+		}
+		if (Utils::GetBodyPartData(a_actor) != Settings::defaultBodyPartData) {
+			return false;  // humanoids only, as for fists
+		}
+		auto process = a_actor->GetActorRuntimeData().currentProcess;
+		if (!process) {
+			return false;
+		}
+		auto equipped = a_bLeft ? process->GetEquippedLeftHand() : process->GetEquippedRightHand();
+		auto weapon = equipped ? equipped->As<RE::TESObjectWEAP>() : nullptr;
+		if (!weapon) {
+			return false;  // shield, torch, spell
+		}
+		switch (weapon->GetWeaponType()) {
+		case RE::WEAPON_TYPE::kOneHandSword:
+		case RE::WEAPON_TYPE::kOneHandDagger:
+		case RE::WEAPON_TYPE::kOneHandAxe:
+		case RE::WEAPON_TYPE::kOneHandMace:
+		case RE::WEAPON_TYPE::kTwoHandSword:
+		case RE::WEAPON_TYPE::kTwoHandAxe:
+			return true;
+		default:
+			return false;  // fists (their own capsule), bows, staves (the list's pistols), crossbows (muskets)
+		}
+	}
+
+	std::vector<Capsule> ComputeAlongBlade(RE::Actor* a_actor, RE::NiNode* a_bone, RE::NiNode* a_attackNode, const RE::hkVector4& a_tip, const RE::hkVector4& a_grip)
+	{
+		std::vector<Capsule> out;
+
+		const float toGame = *g_worldScaleInverse;
+		const float toHavok = *g_worldScale;
+
+		const RE::NiPoint3 tip{ a_tip.quad.m128_f32[0] * toGame, a_tip.quad.m128_f32[1] * toGame, a_tip.quad.m128_f32[2] * toGame };
+		const RE::NiPoint3 grip{ a_grip.quad.m128_f32[0] * toGame, a_grip.quad.m128_f32[1] * toGame, a_grip.quad.m128_f32[2] * toGame };
+		const float bladeLength = (tip - grip).Length();
+		if (bladeLength < 1.f) {
+			return out;
+		}
+
+		// capsules from fStartFraction to the tip, evenly spaced, at most fSpacing apart (at least two, at most four)
+		const float span = (1.f - g_weaponStartFraction) * bladeLength;
+		size_t count = static_cast<size_t>(std::ceil(span / g_weaponSpacing)) + 1;
+		count = std::clamp<size_t>(count, 2, kMaxWeaponCapsules);
+
+		const RE::NiTransform attackWorld = a_bone->world * a_attackNode->local;
+		const float boneScale = a_bone->world.scale != 0.f ? a_bone->world.scale : 1.f;
+		const float feetZ = a_actor->GetPositionZ();
+		const float minLength = g_weaponMinLengthRatio * a_actor->GetHeight();
+
+		for (size_t i = 0; i < count; ++i) {
+			const float t = g_weaponStartFraction + (1.f - g_weaponStartFraction) * static_cast<float>(i) / static_cast<float>(count - 1);
+			const RE::NiPoint3 local = grip + (tip - grip) * t;
+			const RE::NiPoint3 pointWorld = attackWorld.translate + attackWorld.rotate * local;
+			const float length = std::max(pointWorld.z - feetZ, minLength);
+
+			Capsule c;
+			c.localTranslate = (a_bone->world.rotate.Transpose() * (pointWorld - a_bone->world.translate)) / boneScale;
+			c.vertexA = RE::hkVector4(0.f, 0.f, 0.f, 0.f);
+			c.vertexB = RE::hkVector4(0.f, 0.f, -length * toHavok, 0.f);
+			c.radius = g_weaponRadius * a_actor->GetScale() * toHavok;
+			out.push_back(c);
+
+			if (g_weaponLog) {
+				logger::info("ZenUnarmedReach: {:08X} {} blade {:.0f}: capsule {} at {:.2f} ({:.0f} above the feet), {:.0f} units down, radius {:.0f}",
+					a_actor->GetFormID(), a_bone->name.c_str(), bladeLength, i, t, pointWorld.z - feetZ, length, g_weaponRadius * a_actor->GetScale());
+			}
+		}
+		return out;
 	}
 
