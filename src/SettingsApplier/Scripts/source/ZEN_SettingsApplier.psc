Bool Function SetG(String plugin, Int id, String edid, Float value)
	GlobalVariable g = Game.GetFormFromFile(id, plugin) as GlobalVariable
	If !g
		Debug.Trace("[Zenderal Settings Applier] skipped " + edid + ": " + plugin + " not loaded")
		Return False
	EndIf
	If PO3_SKSEFunctions.GetFormEditorID(g) != edid
		Debug.Trace("[Zenderal Settings Applier] skipped " + edid + ": EditorID mismatch in " + plugin)
		Return False
	EndIf
	g.SetValue(value)
	Return True
EndFunction

String Function FindFile(String relPath)
	If JContainers.fileExistsAtPath("Data/" + relPath)
		Return "Data/" + relPath
	ElseIf JContainers.fileExistsAtPath(relPath)
		Return relPath
	EndIf
	Return ""
EndFunction
