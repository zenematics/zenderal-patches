<patch>
	<!-- Zenderal - First Person Fist Combo (arch-docs/patches/FirstPersonFistCombo.md). First person, both hands
	     unarmed: left click chains right hook -> left hook -> right hook. Attack_MCO's AttackRightH2H 0870D6 sends
	     attackStart for fists; 1HM_AttackBehavior (#4333) has attackStart transitions AttackRight_State <-> AttackLeft_State,
	     but they wait for weaponSwing, which SIGMA's and JellyFish's right hooks and every left hook (weaponLeftSwing)
	     never send, so every click restarted a right hook. These transitions accept the click from preHitFrame and start the
	     next punch at the attack window (AttackWinStart / AttackWinStartLeft: after every fist set's Precision hit window)
	     until attackStop. Priority 1 so they are taken before the vanilla ones for fists; weapons fail the condition.
	     Also lets a held fist power attack start during a left hook, as it already could during a right hook. -->
	<Append path="">
		<hkobject name="#zfistcombo$0" class="hkbExpressionCondition" signature="0x1c3c1045">
			<hkparam name="expression">(iRightHandType == 0) &amp;&amp; (iLeftHandType == 0)</hkparam>
		</hkobject>
	</Append>
	<Append path="#4328/transitions">
		<hkobject>
			<hkparam name="triggerInterval">
				<hkobject>
					<hkparam name="enterEventId">$eventID[preHitFrame]$</hkparam>
					<hkparam name="exitEventId">$eventID[attackStop]$</hkparam>
					<hkparam name="enterTime">0.000000</hkparam>
					<hkparam name="exitTime">0.000000</hkparam>
				</hkobject>
			</hkparam>
			<hkparam name="initiateInterval">
				<hkobject>
					<hkparam name="enterEventId">$eventID[AttackWinStart]$</hkparam>
					<hkparam name="exitEventId">$eventID[attackStop]$</hkparam>
					<hkparam name="enterTime">0.000000</hkparam>
					<hkparam name="exitTime">0.000000</hkparam>
				</hkobject>
			</hkparam>
			<hkparam name="transition">#2590</hkparam>
			<hkparam name="condition">#zfistcombo$0</hkparam>
			<hkparam name="eventId">$eventID[attackStart]$</hkparam>
			<hkparam name="toStateId">1</hkparam>
			<hkparam name="fromNestedStateId">0</hkparam>
			<hkparam name="toNestedStateId">0</hkparam>
			<hkparam name="priority">1</hkparam>
			<hkparam name="flags">FLAG_USE_INITIATE_INTERVAL|FLAG_USE_TRIGGER_INTERVAL</hkparam>
		</hkobject>
	</Append>
	<Append path="#3425/transitions">
		<hkobject>
			<hkparam name="triggerInterval">
				<hkobject>
					<hkparam name="enterEventId">$eventID[preHitFrame]$</hkparam>
					<hkparam name="exitEventId">$eventID[attackStop]$</hkparam>
					<hkparam name="enterTime">0.000000</hkparam>
					<hkparam name="exitTime">0.000000</hkparam>
				</hkobject>
			</hkparam>
			<hkparam name="initiateInterval">
				<hkobject>
					<hkparam name="enterEventId">$eventID[AttackWinStartLeft]$</hkparam>
					<hkparam name="exitEventId">$eventID[attackStop]$</hkparam>
					<hkparam name="enterTime">0.000000</hkparam>
					<hkparam name="exitTime">0.000000</hkparam>
				</hkobject>
			</hkparam>
			<hkparam name="transition">#2590</hkparam>
			<hkparam name="condition">#zfistcombo$0</hkparam>
			<hkparam name="eventId">$eventID[attackStart]$</hkparam>
			<hkparam name="toStateId">0</hkparam>
			<hkparam name="fromNestedStateId">0</hkparam>
			<hkparam name="toNestedStateId">0</hkparam>
			<hkparam name="priority">1</hkparam>
			<hkparam name="flags">FLAG_USE_INITIATE_INTERVAL|FLAG_USE_TRIGGER_INTERVAL</hkparam>
		</hkobject>
		<hkobject>
			<hkparam name="triggerInterval">
				<hkobject>
					<hkparam name="enterEventId">-1</hkparam>
					<hkparam name="exitEventId">-1</hkparam>
					<hkparam name="enterTime">0.000000</hkparam>
					<hkparam name="exitTime">0.000000</hkparam>
				</hkobject>
			</hkparam>
			<hkparam name="initiateInterval">
				<hkobject>
					<hkparam name="enterEventId">-1</hkparam>
					<hkparam name="exitEventId">-1</hkparam>
					<hkparam name="enterTime">0.000000</hkparam>
					<hkparam name="exitTime">0.000000</hkparam>
				</hkobject>
			</hkparam>
			<hkparam name="transition">#2593</hkparam>
			<hkparam name="condition">#3429</hkparam>
			<hkparam name="eventId">$eventID[attackPowerStartForwardH2HRightHand]$</hkparam>
			<hkparam name="toStateId">18</hkparam>
			<hkparam name="fromNestedStateId">0</hkparam>
			<hkparam name="toNestedStateId">0</hkparam>
			<hkparam name="priority">0</hkparam>
			<hkparam name="flags">0</hkparam>
		</hkobject>
	</Append>
</patch>
